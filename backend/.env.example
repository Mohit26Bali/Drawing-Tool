# Copy this file to backend/.env and fill it in. .env is git-ignored and never published.

# PostgreSQL connection string. Example for a local database:
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/whiteboard"

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# How long a sign-in lasts (default 7d)
JWT_EXPIRES_IN="7d"

# The website's address (browser origin). Several can be listed, separated by commas.
# Required in production. Defaults to http://localhost:3000 when developing.
CLIENT_URL="http://localhost:3000"

# Port the API listens on (default 4000)
PORT=4000

# Number of reverse proxies in front of the API (Render, Vercel, nginx: 1). Needed for correct client addresses.
TRUST_PROXY=0
